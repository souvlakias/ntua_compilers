{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "PCL",
	"patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
		{
			"include": "#keywords"
		},
		{
			"include": "#functionCalls"
		},
        {
            "include": "#identifiers"
        },
		{
            "include": "#operators"
		}
	],
	"repository": {
		"keywords": {
            "patterns": [
                {
                    "name": "keyword.pcl",
                    "match": "\\b(?:begin|end|if|then|else|while|do|goto|return|program|function|procedure|forward|label|var|new|dispose|of|and|or|not|div|mod|true|false|nil|result|integer|real|boolean|char|array)\\b"
                }
            ]
		},
        "functionCalls": {
            "patterns": [
                {
                    "match": "\\b([A-Za-z][A-Za-z0-9_]*)\\b(?=\\s*\\()",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.pcl"
                        }
                    }
                }
            ]
        },
		"identifiers": {
			"patterns": [
				{
					"name": "variable.other.identifier.pcl",
					"match": "\\b[A-Za-z][A-Za-z0-9_]*\\b"
				}
			]
		},
		"strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.pcl",
                    "begin": "\"",
                    "end": "(?<!\\\\)\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.pcl",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.pcl",
                    "begin": "'",
                    "end": "(?<!\\\\)'",
                    "patterns": [
                        {
                            "name": "constant.character.escape.pcl",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.pcl",
                "match": "\\b(?:\\d+\\.\\d+(?:[eE][+-]?\\d+)?|\\d+(?:[eE][+-]?\\d+)|\\d+)\\b"
                }
            ]
        },
        "comments": {
            "patterns": [
                {
                    "name": "comment.block.pcl",
                    "begin": "\\(\\*",
                    "end": "\\*\\)"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.pcl",
                    "match": ":=|<>|<=|>=|=|<|>|\\+|-|\\*|/|\\^|@"
                },
                {
                    "name": "punctuation.pcl",
                    "match": "[;,\\.:()\\[\\]]"
                }
            ]
        }
	},
	"scopeName": "source.pcl"
}